{
  "name": "readergo-plugins",
  "version": "1.0.0",
  "description": "Official and community plugins for ReaderGo document platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/compile-plugins.mjs && node scripts/build-catalog.mjs",
    "compile": "node scripts/compile-plugins.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "readergo",
    "plugins",
    "marketplace"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.1",
    "@tiptap/extension-font-family": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-history": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-table-cell": "^3.32.1",
    "@tiptap/extension-table-header": "^3.32.1",
    "@tiptap/extension-table-row": "^3.32.1",
    "@tiptap/extension-task-item": "^3.32.1",
    "@tiptap/extension-task-list": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.16.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
