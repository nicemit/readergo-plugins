{
  "id": "readergo.features.outline",
  "name": "Document Structure",
  "version": "1.1.0",
  "description": "Right-sidebar heading outline with jump-to-heading and section collapse for the active note.",
  "category": "feature",
  "provides": [
    "sidebar-panel"
  ],
  "requires": [
    "document-storage"
  ],
  "permissions": [
    "note:read"
  ],
  "trust": "trusted",
  "source": "external",
  "main": "dist/ui.js",
  "runtime": "local",
  "autoActivate": true,
  "compile": {
    "ui": "./src/index.tsx"
  }
}
