{
  "id": "readergo.features.architecture",
  "name": "How ReaderGo Works",
  "version": "1.1.0",
  "description": "Interactive flowcharts of the ReaderGo host, plugin kernel, click pipeline, chat, and install path.",
  "category": "feature",
  "provides": [
    "editor-provider",
    "activity-bar-item",
    "extension-slot"
  ],
  "requires": [
    "document-storage"
  ],
  "permissions": [
    "note:read",
    "note:write"
  ],
  "trust": "trusted",
  "source": "external",
  "main": "dist/ui.js",
  "runtime": "local",
  "autoActivate": true,
  "compile": {
    "ui": "./src/index.tsx"
  }
}
