{
  "id": "readergo.vector-store.lancedb",
  "name": "Vector Store (Local)",
  "version": "0.1.0",
  "sdkVersion": "0.1.0",
  "description": "Local file vector store under ~/.readergo/agent/vectors (provider id lancedb).",
