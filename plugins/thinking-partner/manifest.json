{
  "id": "readergo.features.thinking-partner",
  "name": "Thinking Partner",
  "version": "1.0.7",
  "description": "In-editor intelligence: automatic knowledge connection discovery, unlinked mention linking, and dynamic content-aware actions",
  "category": "ai",
  "provides": [
    "sidebar-panel",
    "thinking-partner-service"
  ],
  "requires": [
    "document-storage"
  ],
  "permissions": [
    "note:read",
    "note:write"
  ],
  "trust": "trusted",
  "source": "external",
  "main": "dist/ui.js",
  "runtime": "local",
  "autoActivate": true,
  "compile": {
    "ui": "./src/index.tsx"
  }
}
