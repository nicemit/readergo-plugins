{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@readergo/plugin-sdk": [
        "./packages/plugin-sdk/src/index.ts"
      ],
      "@readergo/plugin-sdk/*": [
        "./packages/plugin-sdk/src/*"
      ],
      "@/*": [
        "../readergo/src/*"
      ]
    }
  },
  "include": [
    "plugins",
    "packages",
    "types"
  ]
}
